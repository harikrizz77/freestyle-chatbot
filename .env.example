# Copy to .env and fill in. Never commit the real .env (already gitignored).

# --- LLM (agent orchestration layer; never used to compute numeric estimates) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_REPORT_MODEL=claude-sonnet-4-6

# --- Macro data ---
FRED_API_KEY=

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cannibalization-agent

# --- Storage ---
DUCKDB_PATH=data/processed/store.duckdb

# --- Reproducibility ---
RANDOM_SEED=42

# --- Logging ---
LOG_LEVEL=INFO
